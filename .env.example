# Copy to .env and adjust. Local dev defaults shown; see README.md for Atlas-backed values.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=air_quality

# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# Seconds since last reading before a device is reported "offline".
DEVICE_OFFLINE_THRESHOLD_SECONDS=180
